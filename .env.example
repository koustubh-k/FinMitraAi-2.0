# Application
APP_NAME=FinMitra
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://finmitra:finmitra@postgres:5432/finmitra

# Redis
REDIS_URL=redis://redis:6379/0

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# External APIs
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_API_KEY=

# Security
SECRET_KEY=
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MARKET_DATA_PROVIDER=alphavantage,finnhub,fmp,yahoo,tavily,duckduckgo

# Financial APIs
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
MARKETAUX_API_KEY=

# Search APIs
TAVILY_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=

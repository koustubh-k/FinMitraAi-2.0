# --- Application Environment ---
ENVIRONMENT=development
PROJECT_NAME="FinMitra 2.0"
API_V1_STR=/api/v1
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-byte-hex-string

# --- Networking & CORS ---
HOST=0.0.0.0
PORT=8000
API_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Database & Persistence (Host ports: PG 5433, Redis 6380) ---
POSTGRES_USER=finmitra_user
POSTGRES_PASSWORD=finmitra_password
POSTGRES_DB=finmitra_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finmitra_user:finmitra_password@localhost:5433/finmitra_db

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- LLM Providers (Required for Phase 4+) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Market Data Providers ---
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- Observability ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finmitra-2.0
